# TinyUSB NCM Mode
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_SUSPEND_CALLBACK=y
CONFIG_TINYUSB_RESUME_CALLBACK=y
CONFIG_TINYUSB_NCM_IN_NTB_BUFFS_COUNT=6

# IP Forwarding + NAPT (for WiFi -> USB network sharing)
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_STATS=y

# Flash: 16MB, DIO mode, 80MHz freq
CONFIG_ESPTOOLPY_FLASH_MODE_DIO=y
CONFIG_ESPTOOLPY_FLASH_FREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Partition table: custom
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bluetooth
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=y

# Bootloader offset - MUST be 0x1000 for ESP32-S3
CONFIG_BOOTLOADER_OFFSET_IN_FLASH=0x1000
